# Copy this file to .env and replace the connection and model settings.
# Use an account granted only opencode_research_ro by your database administrator.
NIA_DATABASE_URL=postgres://nia_reader:replace-me@localhost:5432/postgres
NIA_SSL=verify-full
NIA_PRINCIPAL=public
NIA_PRIVATE=false

# Any approved OpenAI-compatible tool-capable model, through your chosen endpoint.
NIA_MODEL=custom/your-model-id
NIA_BASE_URL=https://your-provider.example/v1
NIA_API_KEY=replace-me

# Reasoning effort sent as reasoning_effort.
# Options: minimal, low, medium, high, xhigh
# NIA_REASONING_EFFORT=low

# Optional: advanced provider JSON instead of NIA_BASE_URL/NIA_API_KEY.
# NIA_PROVIDERS=/absolute/path/to/providers.json
# Optional: persistent sessions; default remains ~/.opencode-research.
# NIA_STATE=/absolute/path/to/nia-sessions
