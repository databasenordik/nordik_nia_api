# Copy this file to .env and replace the values.
NIA_TRANSPORT=grpc
APP_ENV=production
NIA_GRPC_PRINCIPAL_ID=replace-me
NIA_GRPC_CAN_USE_PRIVATE_FILES=false

# Transcription uses /stt here; the xai TTS provider also uses /tts.
REASONING_BASE_URL=https://your-provider.example/v1
REASONING_API_KEY=replace-me
ASSISTANT_DATABASE_URL=postgresql://assistant_runtime:replace-me@your-database-host:5432/postgres?sslmode=require

# Select TTS with speech.tts.provider in backend/reasoning.json (gemini or xai).
# The selected xAI reader is Leo, speed 0.92, delivery warm, MP3 24 kHz / 128 kbps.
# delivery warm adds soft opening/closing paragraphs and paragraph pauses after source sanitization.
# Use delivery plain to disable the trusted tags. No prose system prompt is sent to xAI TTS.
# Gemini uses Vertex AI application default credentials and its detected Google Cloud project.
# The runtime account needs Vertex AI prediction access. For local use, either configure ADC or
# set GEMINI_API_KEY to use the Gemini Developer API instead. Never store the key in reasoning.json.
# GOOGLE_CLOUD_PROJECT=your-google-cloud-project
# GEMINI_API_KEY=replace-me
