# Copy this file to .env and replace the values.
NIA_TRANSPORT=grpc
APP_ENV=production
NIA_GRPC_PRINCIPAL_ID=replace-me
NIA_GRPC_CAN_USE_PRIVATE_FILES=false

REASONING_BASE_URL=https://your-provider.example/v1
REASONING_API_KEY=replace-me
ASSISTANT_DATABASE_URL=postgresql://assistant_runtime:replace-me@your-database-host:5432/postgres?sslmode=require
