{
  "compilerOptions": {
    "noUnusedLocals": true,
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "incremental": true,
    "noEmit": false,
    "noUncheckedIndexedAccess": false,
    "outDir": "node_modules/.ts-dist/source",
    "rootDir": "src",
    "tsBuildInfoFile": "node_modules/.ts-dist/source.tsbuildinfo"
  }
}
