{
  "compilerOptions": {
    "noUnusedLocals": true,
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": false,
    "allowJs": false,
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": false
  }
}
